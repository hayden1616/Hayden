# Copy to .env for production. Development defaults are safe and local.
PORT=8000
DATABASE_PATH=data/industrial.db
SESSION_SECRET=replace-with-a-long-random-secret-before-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production
SITE_ORIGIN=http://localhost:8000
# Kept disabled unless explicitly configured by an operator in Admin.
DELIVERY_ENDPOINT=

